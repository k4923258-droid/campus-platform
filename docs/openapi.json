    "/commands/activity.save": {
      "post": {
        "summary": "activity.save",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "orgId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "poster": {
                    "type": "string"
                  },
                  "start": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "published": {
                    "type": "boolean"
                  },
                  "external": {
                    "type": "boolean"
                  },
                  "externalGuide": {
                    "type": "string"
                  },
                  "team": {
                    "type": "boolean"
                  },
                  "minTeam": {
                    "type": "integer"
                  },
                  "maxTeam": {
                    "type": "integer"
                  },
                  "rolling": {
                    "type": "boolean"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "text",
                            "textarea",
                            "number",
                            "radio",
                            "checkbox",
                            "date",
                            "file"
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "label",
                        "type",
                        "required",
                        "options"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "stages": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "enum": [
                            "initial",
                            "written",
                            "interview"
                          ]
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "automatic": {
                          "type": "boolean"
                        },
                        "mode": {
                          "enum": [
                            "pass",
                            "score"
                          ]
                        },
                        "threshold": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "key",
                        "enabled",
                        "automatic",
                        "mode",
                        "threshold"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "softGrade": {
                    "type": "string"
                  },
                  "softMaterial": {
                    "type": "string"
                  },
                  "publishedAt": {
                    "type": "string"
                  },
                  "removed": {
                    "type": "boolean"
                  },
                  "resultPublished": {
                    "type": "boolean"
                  },
                  "resultVersion": {
                    "type": "integer"
                  },
                  "closedAt": {
                    "type": "string"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "summary": {
                    "type": "object"
                  }
                },
                "required": [
                  "orgId",
                  "title",
                  "body",
                  "start",
                  "end",
                  "published",
                  "external",
                  "team",
                  "minTeam",
                  "maxTeam",
                  "rolling",
                  "fields",
                  "stages"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；只返回当前角色与组织允许读取的数据"
          },
          "401": {
            "description": "未登录或会话失效"
          },
          "403": {
            "description": "没有权限或CSRF验证失败"
          },
          "404": {
            "description": "记录或操作不存在"
          },
          "409": {
            "description": "版本、状态、唯一性或容量冲突"
          },
          "422": {
            "description": "业务参数校验失败"
          },
          "503": {
            "description": "初始化或维护中"
          }
        }
      }
    },
