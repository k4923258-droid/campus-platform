{
  "openapi": "3.1.0",
  "info": {
    "title": "校园社团与竞赛平台接口",
    "version": "0.4.0",
    "description": "命令接口按业务操作命名；模拟版与Java版共用相同路径。服务端权限由业务层校验，前端按钮隐藏不构成授权。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/snapshot": {
      "get": {
        "summary": "按角色与所属组织返回业务投影；不返回密码或附件二进制",
        "responses": {
          "200": {
            "description": "成功；只返回当前角色与组织允许读取的数据"
          },
          "401": {
            "description": "未登录或会话失效"
          },
          "403": {
            "description": "没有权限或CSRF验证失败"
          },
          "404": {
            "description": "记录或操作不存在"
          },
          "409": {
            "description": "版本、状态、唯一性或容量冲突"
          },
          "422": {
            "description": "业务参数校验失败"
          },
          "503": {
            "description": "初始化或维护中"
          }
        }
      }
    },
    "/csrf": {
      "get": {
        "summary": "领取CSRF Cookie和令牌，写操作携带X-XSRF-TOKEN",
        "responses": {
          "200": {
            "description": "CSRF token"
          }
        }
      }
    },
    "/session": {
      "post": {
        "summary": "登录；服务器使用HttpOnly JSESSIONID，模拟模式返回30分钟token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "studentNo": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "studentNo",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；只返回当前角色与组织允许读取的数据"
          },
          "401": {
            "description": "未登录或会话失效"
          },
          "403": {
            "description": "没有权限或CSRF验证失败"
          },
          "404": {
            "description": "记录或操作不存在"
          },
          "409": {
            "description": "版本、状态、唯一性或容量冲突"
          },
          "422": {
            "description": "业务参数校验失败"
          },
          "503": {
            "description": "初始化或维护中"
          }
        }
      },
      "delete": {
        "summary": "退出并使当前会话失效",
        "responses": {
          "200": {
            "description": "成功；只返回当前角色与组织允许读取的数据"
          },
          "401": {
            "description": "未登录或会话失效"
          },
          "403": {
            "description": "没有权限或CSRF验证失败"
          },
          "404": {
            "description": "记录或操作不存在"
          },
          "409": {
            "description": "版本、状态、唯一性或容量冲突"
          },
          "422": {
            "description": "业务参数校验失败"
          },
          "503": {
            "description": "初始化或维护中"
          }
        }
      }
    },
    "/files": {
      "post": {
        "summary": "上传20MB以内图片/PDF/ZIP；服务端校验扩展名、声明MIME、实际内容与字节数",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "mime": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20971520
                  },
                  "data": {
                    "type": "string",
                    "description": "base64 data URL"
                  }
                },
                "required": [
                  "name",
                  "mime",
                  "size",
                  "data"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；只返回当前角色与组织允许读取的数据"
          },
          "401": {
            "description": "未登录或会话失效"
          },
          "403": {
            "description": "没有权限或CSRF验证失败"
          },
          "404": {
            "description": "记录或操作不存在"
          },
