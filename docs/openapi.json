            "description": "版本、状态、唯一性或容量冲突"
          },
          "422": {
            "description": "业务参数校验失败"
          },
          "503": {
            "description": "初始化或维护中"
          }
        }
      }
    },
    "/files/{id}": {
      "get": {
        "summary": "受权限保护的文件下载",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
