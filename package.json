{
  "name": "campus-platform",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "dev:server": "vite --mode server --host 127.0.0.1",
    "test:rules": "vitest run src/domain/__tests__",
    "test:server": "node scripts/verify-server.mjs",
    "contract": "node scripts/generate-contract.mjs"
  },
  "dependencies": {
    "axios": "1.21.0",
    "dompurify": "3.4.17",
    "element-plus": "2.14.7",
    "exceljs": "4.4.0",
    "localforage": "1.10.0",
    "lucide-vue-next": "0.577.0",
    "markdown-it": "15.0.3",
    "msw": "2.15.0",
    "papaparse": "5.7.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "npm-run-all2": "9.0.4",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-java": "2.11.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
